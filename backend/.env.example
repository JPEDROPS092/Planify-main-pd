DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.planify.local

# Use SQLite only for legacy/local inspection before PostgreSQL is available.
USE_SQLITE=False

POSTGRES_DB=planify
# Administrative DB owner for migrations, seed, setup_rls and tests.
POSTGRES_USER=planify
POSTGRES_PASSWORD=planify
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

# Runtime web role for native PostgreSQL RLS.
# Provision/update it first with:
#   APP_DB_PASSWORD=app_user python manage.py setup_rls
# Then run the web process with:
#   POSTGRES_USER=app_user
#   POSTGRES_PASSWORD=app_user
APP_DB_PASSWORD=app_user

SHOW_PUBLIC_IF_NO_TENANT_FOUND=True
